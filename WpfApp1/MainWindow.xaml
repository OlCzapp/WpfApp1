<Window x:Class="WpfApp1.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfApp1"
        mc:Ignorable="d"
        Title="MainWindow" Height="420" Width="900"
        Background="#ede3cc">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1*"/>
            <ColumnDefinition Width="1*"/>
        </Grid.ColumnDefinitions>

        <GroupBox Margin="18" BorderBrush="White" BorderThickness="2">

            <StackPanel Orientation="Vertical" Margin="20">
                <Label Content="Formularz opini na temat zamówionego stołu:"></Label>
                <StackPanel Orientation="Horizontal">
                    <StackPanel Orientation="Vertical">
                        <TextBlock Text="Imię:" Margin="0,10,0,10"/>
                        <TextBlock Text="Nazwisko:"/>
                    </StackPanel>
                    <StackPanel Orientation="Vertical" Margin="20,0,0,0">
                        <TextBox Width="200" Margin="0,10,0,10"/>
                        <TextBox Width="200"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Margin="0,30,0,0">
                    <GroupBox Header="Płeć:" BorderBrush="White" Padding="5" BorderThickness="2">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton Margin="0,5,0,5" Content="Kobieta"></RadioButton>
                            <RadioButton Margin="5" Content="Mężczyzna"></RadioButton>
                            <RadioButton Margin="5" Content="wolę nie podawać"></RadioButton>
                        </StackPanel>
                    </GroupBox>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,30,0,0">
                    <TextBlock Text="model: "></TextBlock>
                    <ComboBox Width="120" Margin="35,0,0,0" >
                        <ComboBoxItem Content="Klasyczny"></ComboBoxItem>
                        <ComboBoxItem Content="Nowoczesny"></ComboBoxItem>
                        <ComboBoxItem Content="Rustykalny"></ComboBoxItem>
                        <ComboBoxItem Content="Industrialny"></ComboBoxItem>
                        <ComboBoxItem Content="Skandynawski"></ComboBoxItem>
                    </ComboBox>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,20,0,0">
                    <TextBlock Text="Ocena zamówionego stołu: "></TextBlock>
                    <Slider Width="150" Minimum="1" Maximum="5" TickFrequency="1" IsSnapToTickEnabled="True" Margin="10,0,0,0"/>
                    <TextBlock Text="{Binding ElementName=slider, Path=Value}" Margin="10,0,0,0"/>
                </StackPanel>

            </StackPanel>
        </GroupBox>

        <GroupBox Grid.Column="1" Margin="18" BorderBrush="White" BorderThickness="2">
            <StackPanel>
                <StackPanel Margin="10,0,0,0">
                    <TextBlock Text="Czy polecił(a)byś naszą firmę znajomym?" Margin="0,20,0,5"/>
                    <CheckBox Content="Tak, zdecydowanie" Margin="0,5,0,5"/>
                    <CheckBox Content="Może, zależy od sytuacji" Margin="0,5,0,5"/>
                    <CheckBox Content="Nie, nie polecę" Margin="0,5,0,5"/>
                </StackPanel>
                
                <StackPanel>
                    <TextBlock Text="Dodatkowe uwagi dotyczące zamówionego stołu:" Margin="10,10,10,10"/>
                    <TextBox Width="300" Height="100" TextWrapping="Wrap" AcceptsReturn="True"/>
                </StackPanel>

                <StackPanel HorizontalAlignment="Center">
                    <Button Content="Wyślij opinię" Width="100" Margin="10,20,0,0"/>
                    <TextBlock Foreground="#8a6f34" FontSize="20" Text="Dziękujemy za poświęcony czas!" Margin="10,10,0,0" HorizontalAlignment="Center"/>
                </StackPanel>
            </StackPanel>
        </GroupBox>
    </Grid>
</Window>
