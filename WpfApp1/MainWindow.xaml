<Window x:Class="WpfApp1.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfApp1"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="900"
        Background="#ede3cc">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1*"/>
            <ColumnDefinition Width="1*"/>
        </Grid.ColumnDefinitions>

        <GroupBox Margin="18" BorderBrush="White" BorderThickness="2">

            <StackPanel Orientation="Vertical" Margin="20">
                <Label Content="Formularz opini na temat zamówionego stołu:"></Label>
                <StackPanel Orientation="Horizontal">
                    <StackPanel Orientation="Vertical">
                        <TextBlock Text="Imię:" Margin="0,10,0,10"/>
                        <TextBlock Text="Nazwisko:"/>
                    </StackPanel>
                    <StackPanel Orientation="Vertical" Margin="20,0,0,0">
                        <TextBox x:Name="imie" Width="200" Margin="0,10,0,10"/>
                        <TextBox x:Name="nazwisko" Width="200"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Margin="0,30,0,0">
                    <GroupBox Header="Płeć:" BorderBrush="White" Padding="5" BorderThickness="2">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton x:Name="k" GroupName="plec" Margin="0,5,0,5" Content="Kobieta"></RadioButton>
                            <RadioButton x:Name="m" GroupName="plec" Margin="5" Content="Mężczyzna"></RadioButton>
                            <RadioButton x:Name="inne" GroupName="plec" IsChecked="True" Margin="5" Content="wolę nie podawać"></RadioButton>
                        </StackPanel>
                    </GroupBox>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,30,0,0">
                    <TextBlock Text="model: "></TextBlock>
                    <ComboBox x:Name="combobox" Width="120" Margin="35,0,0,0" >
                        <ComboBoxItem Name="a" Content="Klasyczny"></ComboBoxItem>
                        <ComboBoxItem Name="b" Content="Nowoczesny"></ComboBoxItem>
                        <ComboBoxItem Name="c" Content="Rustykalny"></ComboBoxItem>
                        <ComboBoxItem Name="d" Content="Industrialny"></ComboBoxItem>
                        <ComboBoxItem Name="e" Content="Skandynawski"></ComboBoxItem>
                    </ComboBox>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,20,0,0">
                    <TextBlock Text="Ocena zamówionego stołu: "></TextBlock>
                    <Slider Width="150" Minimum="1" Maximum="5" TickFrequency="1" IsSnapToTickEnabled="True" Margin="10,0,0,0"/>
                </StackPanel>

            </StackPanel>
        </GroupBox>

        <GroupBox Grid.Column="1" Margin="18" BorderBrush="White" BorderThickness="2">
            <StackPanel>
                <StackPanel Margin="10,0,0,0">
                    <TextBlock Text="Czy polecił(a)byś naszą firmę znajomym?" Margin="0,20,0,5"/>
                    <CheckBox Checked="tak_Checked" Unchecked="tak_Checked" x:Name="tak" Content="Tak, zdecydowanie" Margin="0,5,0,5"/>
                </StackPanel>
                
                <StackPanel x:Name="opiniaVisibility" Visibility="Hidden">
                    <TextBlock Text="Dodatkowe uwagi dotyczące zamówionego stołu:" Margin="10,10,10,10"/>
                    <TextBox x:Name="opiniaKlienta" Width="300" Height="150" TextWrapping="Wrap" AcceptsReturn="True"/>
                </StackPanel>

                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Visibility="Hidden" Foreground="#8a6f34" FontSize="20" Text="Dziękujemy za poświęcony czas!" Margin="10,10,0,0" HorizontalAlignment="Center"/>
                    <Button x:Name="opinia" Click="opinia_Click" Content="Wyślij opinię" Width="150" Height="30" Margin="10,20,0,0"/>
                </StackPanel>
            </StackPanel>
        </GroupBox>
    </Grid>
</Window>
